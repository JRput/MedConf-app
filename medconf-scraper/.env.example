# MedConf scraper — required env vars
#
# Copy to .env and fill in the actual values. The real .env is gitignored.
# CI reads the same names from GitHub Actions secrets.

# ---------- LLM (NVIDIA-hosted, OpenAI-compatible) ----------

# NVIDIA API key. Get one at https://build.nvidia.com then click the key
# icon on any model page. Format: nvapi-<40+ chars>.
KIMI_API_KEY=nvapi-YOUR_KEY_HERE

# OpenAI-compatible endpoint. Should not need to change.
KIMI_BASE_URL=https://integrate.api.nvidia.com/v1

# Text model fallback chain for description / specialty extraction +
# remediator prompts, comma-separated, tried in order. llm_client.py
# advances past any model NVIDIA reports as gone (404/410) and stays on
# the next one for the rest of the process. NVIDIA retired every
# moonshotai/kimi-k2.* variant in July 2026, then meta/llama-3.3-70b-instruct
# itself on 2026-08-26 — both with no warning. Leave unset to use
# config.py's default chain; set KIMI_MODEL instead for a one-off single
# override (it's prepended to the chain).
# KIMI_MODEL_CHAIN=nvidia/nemotron-3-super-120b-a12b,meta/muse-glimmer-30b,openai/gpt-oss-20b
# KIMI_MODEL=meta/llama-3.3-70b-instruct

# Vision model fallback chain for image-based fee tables (RCR AI
# Conference / ESTRO). Same advance-on-EOL behaviour as KIMI_MODEL_CHAIN.
# See vision.py's rotation log — meta/muse-glimmer-30b and
# meta/llama-3.2-11b-vision-instruct are the two confirmed-live options
# as of 2026-09-20; neither has been checked against a real complex fee
# image recently (only a synthetic one — see vision.py).
# KIMI_VISION_MODEL_CHAIN=meta/muse-glimmer-30b,meta/llama-3.2-11b-vision-instruct
# KIMI_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# ---------- Supabase ----------

# Public project URL (safe to commit; kept here for local dev parity).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# SERVICE-ROLE key. Bypasses RLS. Scraper-only — never expose client-side.
SUPABASE_KEY=eyJ...

# ---------- Optional scraper tuning ----------

# Default Playwright page.goto / locator timeout in ms. Bumped from
# 10 s → 30 s in 2026-07-16 after RCEM/BTOG hit false-positive
# timeouts on slow days.
SCRAPER_TIMEOUT_MS=30000

# Max agent loop steps before giving up on an event.
SCRAPER_MAX_STEPS=30

# Politeness delay between requests to the same host.
SCRAPER_DELAY_SECONDS=2
