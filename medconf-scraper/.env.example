# MedConf scraper — required env vars
#
# Copy to .env and fill in the actual values. The real .env is gitignored.
# CI reads the same names from GitHub Actions secrets.

# ---------- LLM (NVIDIA-hosted, OpenAI-compatible) ----------

# NVIDIA API key. Get one at https://build.nvidia.com then click the key
# icon on any model page. Format: nvapi-<40+ chars>.
KIMI_API_KEY=nvapi-YOUR_KEY_HERE

# OpenAI-compatible endpoint. Should not need to change.
KIMI_BASE_URL=https://integrate.api.nvidia.com/v1

# Text model for description / specialty extraction + remediator prompts.
# NVIDIA retired every moonshotai/kimi-k2.* variant in July 2026 (410
# Gone). Current working choice: meta/llama-3.3-70b-instruct. Fallback:
# nvidia/llama-3.3-nemotron-super-49b-v1.
KIMI_MODEL=meta/llama-3.3-70b-instruct

# Vision model for image-based fee tables (RCR AI Conference / ESTRO).
# Fallback: meta/llama-3.2-11b-vision-instruct (less accurate on
# multi-column tables — see vision.py rotation note).
KIMI_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# ---------- Supabase ----------

# Public project URL (safe to commit; kept here for local dev parity).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# SERVICE-ROLE key. Bypasses RLS. Scraper-only — never expose client-side.
SUPABASE_KEY=eyJ...

# ---------- Optional scraper tuning ----------

# Default Playwright page.goto / locator timeout in ms. Bumped from
# 10 s → 30 s in 2026-07-16 after RCEM/BTOG hit false-positive
# timeouts on slow days.
SCRAPER_TIMEOUT_MS=30000

# Max agent loop steps before giving up on an event.
SCRAPER_MAX_STEPS=30

# Politeness delay between requests to the same host.
SCRAPER_DELAY_SECONDS=2
