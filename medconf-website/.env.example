# MedConf website — required env vars
#
# Copy to .env.local and fill in the actual values. The real .env.local
# is gitignored. Vercel reads the same names from Project Settings →
# Environment Variables (when the frontend is deployed).

# ---------- Supabase (public — client-side safe) ----------

# Same project URL as scraper/.env
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable (anon) key. Client-side safe. Reads gated by RLS.
# NOT the service-role key — that stays scraper-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
